[Unit]
Description=Moon GameHub Weiqi
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gamehub-weiqi
WorkingDirectory=/opt/weiqi/current
ExecStart=/opt/pokemon-showdown/runtime/current/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=18891
Environment=BASE_PATH=/gamehub/weiqi
Environment=PUBLIC_ORIGIN=https://release.moonl.cloud
Environment=DB_PATH=/var/lib/gamehub-weiqi/rooms.sqlite
Environment=TRUST_PROXY=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
